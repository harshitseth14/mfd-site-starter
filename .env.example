# Copy to .env.local for local work, and set the same names in your host's settings for the live site.
# Everything is optional on a laptop: with no database the forms still work, and with no mail settings
# each lead is printed to the terminal instead of emailed.

# Postgres. DATABASE_URL is used by the site (a pooled URL if your host gives one);
# DATABASE_URL_UNPOOLED, if set, is used by `npm run db:migrate`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Outgoing mail (SMTP). Port 465 uses TLS; any other port uses STARTTLS when the server offers it.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# The From address. Falls back to EMAIL_FROM, then SMTP_USER.
SMTP_FROM=
EMAIL_FROM=

# Where leads are emailed. Defaults to site.email in lib/site.ts.
CONSULT_TO=
# Extra addresses that get a copy of every lead, separated by commas.
LEAD_COPY_TO=
